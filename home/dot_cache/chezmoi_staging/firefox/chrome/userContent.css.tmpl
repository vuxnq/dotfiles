@-moz-document url("about:home"), url("about:newtab"), url("about:blank") {
  :root {
    --newtab-primary-action-background: #{{ .theme.colors.a_lavender }} !important;
    --newtab-background-color-secondary: #{{ .theme.colors.bg }} !important;
  }
  * {
    font-family: {{ .theme.font.name }}, monospace;
    font-weight: 700;
  }
  /* body { background-color: transparent !important; } */
  body { background-color: #{{ .theme.colors.bg_darkest }} !important; }
  .icon.icon-settings { color: #{{ .theme.colors.fg }} !important; }
  .card-context-icon { fill: #{{ .theme.colors.fg }} !important; }
  .card:hover .card-details,.card:hover .card-context, .context-menu-button:hover { background-color: #{{ .theme.colors.bg_darkest }} !important; }
  .context-menu-button { background-color: var(--newtab-background-color-secondary) !important; }

  .logo-and-wordmark {
    .logo { display: none !important; }
    .wordmark {
      background: unset !important;
      width: unset !important;
      &::before {
        content: "firefox";
        white-space: pre-wrap;
        display: block;
        color: #{{ .theme.colors.fg }};
        font-size: 20px;
      }
    }
  }
    
  .search-wrapper {
    .search-handoff-button,
    input {
      border: {{ .theme.ui.border_size }}px solid #{{ .theme.colors.s_0 }} !important;
      border-radius: {{ .theme.ui.rounding }}px !important;
      box-shadow: none !important;
      color: #{{ .theme.colors.fg }} !important;
    }
  }
}

