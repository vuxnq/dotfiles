* {
  border: none;
  border-radius: 4px;
  min-height: 0;
  font-family: {{ .theme.font.name }} ExtraBold;
  font-size: 12px;
}

@keyframes blink {
  to {
    background-color: #{{ .theme.colors.a_rose }};
    color: #{{ .theme.colors.bg_dark }};
  }
}

window#waybar {
  background-color: transparent;
}

#workspaces,
#taskbar {
  background-color: #{{ .theme.colors.bg }};
  margin: 4px 2px 0 2px;
  padding: 2px;
}

#workspaces button,
#taskbar button {
  all: initial; /* Remove GTK theme values (waybar #1351) */
  padding: 0 9px;
  color: #{{ .theme.colors.fg }};
  border-radius: 2px;
  transition-duration: 0.1s;
}

#taskbar button {
  padding: 0 4px;
}

#workspaces button.active,
#workspaces button.focused,
#workspaces button.special.active,
#taskbar button.active {
  color: #{{ .theme.colors.bg }};
  background-color: #{{ .theme.colors.fg }};
}

#workspaces button:hover,
#taskbar button:hover {
  color: #{{ .theme.colors.bg }};
  background-color: #{{ .theme.colors.a_lavender }};
}

#workspaces button.urgent {
  color: #{{ .theme.colors.bg }};
  background-color: #{{ .theme.colors.a_red }};
}

window#waybar.empty #window,
window#waybar.floating #window {
  background-color: transparent;
  color: transparent;
}

#language,
#mode,
#hardware,
#clock,
#custom-spotify,
#window,
#tray,
#battery,
#backlight,
#custom-hostname,
#pulseaudio,
#pulseaudio.muted,
#network,
#bluetooth {
  margin: 4px 2px 0 2px;
  padding: 0 4px;
  background-color: #{{ .theme.colors.bg }};
  color: #{{ .theme.colors.fg }};
}

/* fullscreen */
window#waybar.fullscreen {
  border-radius: 0;
  background-color: #{{ .theme.colors.bg_darkest }};
}
window#waybar.fullscreen #language,
window#waybar.fullscreen #mode,
window#waybar.fullscreen #workspaces,
window#waybar.fullscreen #taskbar,
window#waybar.fullscreen #hardware,
window#waybar.fullscreen #clock,
window#waybar.fullscreen #custom-spotify,
window#waybar.fullscreen #window,
window#waybar.fullscreen #tray,
window#waybar.fullscreen #battery,
window#waybar.fullscreen #backlight,
window#waybar.fullscreen #custom-hostname,
window#waybar.fullscreen #pulseaudio,
window#waybar.fullscreen #pulseaudio.muted,
window#waybar.fullscreen #network,
window#waybar.fullscreen #bluetooth {
  margin-top: 0;
}

#custom-hostname {
  margin-left: 4px;
}

#mode {
  background-color: #{{ .theme.colors.fg }};
  color: #{{ .theme.colors.bg }};
}

#custom-spotify {
  color: #{{ .theme.colors.a_green }};
}

#memory {
  color: #{{ .theme.colors.a_flamingo }};
}
#cpu {
  color: #{{ .theme.colors.a_maroon }};
}
#temperature {
  color: #{{ .theme.colors.a_red }};
}

#battery.plugged {
  color: #{{ .theme.colors.a_green }};
}
#battery.charging {
  background-color: #{{ .theme.colors.a_green }};
  color: #{{ .theme.colors.bg }};
}
#battery.warning {
  background-color: #{{ .theme.colors.a_red }};
  color: #{{ .theme.colors.bg }};
}
#battery.critical,
#battery.urgent {
  background-color: #{{ .theme.colors.a_red }};
  color: #{{ .theme.colors.bg }};
  animation: blink 0.5s ease infinite alternate;
}

#pulseaudio {
  color: #{{ .theme.colors.a_yellow }};
}
#pulseaudio:not(.source-muted) {
  background-color: #{{ .theme.colors.a_yellow }};
  color: #{{ .theme.colors.bg }};
}

#network.wifi,
#network.linked,
#network.ethernet {
  color: #{{ .theme.colors.a_peach }};
}

#clock {
  margin-right: 4px;
}

/* toggle */
#workspaces button.special,
#pulseaudio.input,
#bluetooth {
  color: #{{ .theme.colors.fg }};
  background-color: #{{ .theme.colors.s_0 }};
}

/* fix non-mono icons */
#network, #bluetooth {
  padding-right: 2px;
}

/* children of groups */
#hardware .child * {
  margin-right: 10px;
}

tooltip {
  color: #{{ .theme.colors.fg }};
  background-color: #{{ .theme.colors.bg_darkest }};
  border: 2px solid #{{ .theme.colors.s_0 }};
}

tooltip label {
  padding: 5px;
}
