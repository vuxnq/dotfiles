{
  "layer": "top",
  "reload_style_on_change": true,
  "modules-left": [
    "custom/hostname",
    "hyprland/workspaces",
    "sway/workspaces",
    "group/windows",
    "sway/mode"
  ],
  "modules-center": [
    "custom/spotify"
  ],
  "modules-right": [
    "tray",
    "group/hardware",
    "group/net",
    "group/audio",
    "battery",
    "hyprland/language",
    "sway/language",
    "clock"
  ],
  "group/windows": {
    "orientation": "inherit",
    "modules": [
      "hyprland/window",
      "sway/window",
      "wlr/taskbar"
    ],
    "drawer": {
      "transition-left-to-right": false,
      "children-class": "child"
    }
  },
  "group/hardware": {
    "orientation": "inherit",
    "modules": [
      "temperature",
      "cpu",
      "memory"
    ]
  },
  "group/net": {
    "orientation": "inherit",
    "modules": [
      "network",
      "bluetooth"
    ],
    "drawer": {
      "transition-left-to-right": false,
      "children-class": "child"
    }
  },
  "group/audio": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "pulseaudio#input"
    ],
    "drawer": {
      "transition-left-to-right": false,
      "children-class": "child"
    }
  },
  "custom/hostname": {
    "format": "{{ .hostname }}",
    "tooltip": false,
    "on-click": "~/.config/rofi/launcher.sh",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"s\")'"
    // "on-click-right": "~/.config/sway/toggle_special.sh"
  },
  "hyprland/workspaces": {
    "show-special": true,
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"s\")'"
  },
  "sway/workspaces": {
    "show-special": true,
    "format": "{name}",
    // "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    // "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-click-right": "~/.config/sway/toggle_special.sh"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 10,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "": "vuxnq"
    },
    "max-length": 50
  },
  "sway/window": {
    "format": "{}",
    "rewrite": {
      "": "vuxnq"
    },
    "max-length": 50
  },
  "custom/spotify": {
    "exec": "~/.local/bin/nowplaying.sh waybar",
    "return-type": "json",
    "format": "{icon} {0}",
    "format-icons": {
      "playing": "",
      "paused": ""
    },
    "on-click": "~/.config/rofi/mediaplayer.sh",
    // TODO: verify the alter_z_order field name (guessed "mode") against
    // the Lua LSP stubs / hl.dsp.window.alter_z_order docs on your machine -
    // this dispatcher exists in 0.55+ but its exact table shape wasn't
    // confirmable from public docs at the time this was written.
    "on-click-right": "hyprctl dispatch 'hl.dsp.focus({ window = \"class:spotify\" })' && hyprctl dispatch 'hl.dsp.window.bring_to_top()'",
    // "on-click-right": "swaymsg [class=spotify] focus",
    "on-click-middle": "playerctl --player=spotify play-pause",
    "on-click-forward": "playerctl --player=spotify next",
    "on-click-backward": "playerctl --player=spotify previous",
    "on-scroll-up": "playerctl --player=spotify volume 0.05+",
    "on-scroll-down": "playerctl --player=spotify volume 0.05-"
  },
  "tray": {
    "spacing": 10
  },
  "memory": {
    "interval": 5,
    "format": "󰧑 {}%"
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}% "
  },
  "temperature": {
    "interval": 5,
    "format": " {}°C "
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤭 ",
    "format-disabled": "󰤭 ",
    "tooltip-format-wifi": "{icon} {essid} {frequency}\n {bandwidthDownBytes}   {bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀  {ifname}\n {bandwidthDownBytes}   {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/rofi/wifi.sh",
    "on-click-middle": "~/.config/rofi/wifi.sh toggle",
    "interval": 5,
    "nospacing": 1
  },
  "bluetooth": {
    "format-on": "󰂯 {num_connections}",
    "format-off": "󰂲 ",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "~/.config/rofi/bluetooth.sh",
    "on-click-middle": "~/.config/rofi/bluetooth.sh toggle"
  },
  "pulseaudio": {
    "format": "{format_source}{icon} {volume}%",
    "format-source": " {}% | ",
    "format-source-muted": "",
    "format-bluetooth": "󰂰",
    "nospacing": 1,
    "format-muted": " ",
    "format-icons": {
      "headphone": "",
      "default": [" ", " ", " "]
    },
    "on-click": "~/.config/rofi/volume.sh",
    "on-click-middle": "~/.local/bin/volume.sh mute",
    "on-scroll-down": "~/.local/bin/volume.sh down 2",
    "on-scroll-up": "~/.local/bin/volume.sh up 2"
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " ",
    "on-click": "~/.config/rofi/volume.sh mic",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "on-click": "~/.config/rofi/battery.sh"
  },
  "hyprland/language": {
    "format": "{short}"
  },
  "clock": {
    "tooltip-format": "{:%A}\n{calendar}",
    "format": "{:%d|%m|%y  %H:%M}",
    "on-click": "~/.config/rofi/powermenu.sh"
  }
}
