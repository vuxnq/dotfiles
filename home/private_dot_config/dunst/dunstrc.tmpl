[global]
    follow = keyboard
    format = "<b>%s</b>\n%b"

    icon_path = "~/.local/share/icons/"
    max_icon_size = 64
    enable_recursive_icon_lookup = true

    origin = top-right
    offset = 10x10
    frame_width = 2
    frame_color = "#{{ .colors.s_0 }}"
    separator_color= frame
    font = "{{ .font_main }} Medium"
    corner_radius = 2
    background = "#{{ .colors.bg_darkest }}"
    foreground = "#{{ .colors.fg }}"

    progress_bar_corner_radius = 2
    
[urgency_low]
    foreground = "#{{ .colors.fg }}"
    highlight = "#{{ .colors.a_lavender }}"
    timeout = 4

[urgency_normal]
    foreground = "#{{ .colors.fg }}"
    highlight = "#{{ .colors.a_lavender }}"
    timeout = 6

[urgency_critical]
    foreground = "#{{ .colors.fg }}"
    highlight = "#{{ .colors.a_lavender }}"
    timeout = 0
