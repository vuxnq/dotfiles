* {
    font:                           "{{ .theme.font.name }} Bold 10";
    background:                     #{{ .theme.colors.bg_darkest }};
    background-alt:                 #{{ .theme.colors.bg }};
    foreground:                     #{{ .theme.colors.fg }};
    selected:                       #{{ .theme.colors.a_lavender }};
    active:                         #{{ .theme.colors.fg }};
    urgent:                         #{{ .theme.colors.a_red }};
    border:                         #{{ .theme.colors.s_0 }};

    border-colour:                  @selected;
    handle-colour:                  @selected;
    background-colour:              @background;
    foreground-colour:              @foreground;
    alternate-background:           @background-alt;
    normal-background:              @background;
    normal-foreground:              @foreground;
    urgent-background:              @urgent;
    urgent-foreground:              @background;
    active-background:              @active;
    active-foreground:              @background;
    selected-normal-background:     @selected;
    selected-normal-foreground:     @background;
    selected-urgent-background:     @active;
    selected-urgent-foreground:     @background;
    selected-active-background:     @urgent;
    selected-active-foreground:     @background;
    alternate-normal-background:    @background;
    alternate-normal-foreground:    @foreground;
    alternate-urgent-background:    @urgent;
    alternate-urgent-foreground:    @background;
    alternate-active-background:    @active;
    alternate-active-foreground:    @background;
}

configuration {
    me-select-entry:                "MousePrimary";
    me-accept-entry:                "!MousePrimary";
    kb-cancel:                      "Escape,MouseSecondary";
}

window {
    width:                          600px;
    margin:                         0px;
    padding:                        0px;
    border:                         {{ .theme.ui.border_size }}px solid;
    border-radius:                  {{ .theme.ui.rounding }}px;
    border-color:                   @border;
    background-color:               @background-colour;
}

mainbox {
    spacing:                        {{ .theme.rofi.gaps_in }}px;
    padding:                        {{ .theme.rofi.gaps_out }}px;
    background-color:               transparent;
}

inputbar {
    spacing:                        {{ .theme.rofi.gaps_in }}px;
    border-color:                   @border-colour;
    background-color:               transparent;
    text-color:                     @foreground-colour;
}

prompt {
    background-color:               inherit;
    text-color:                     inherit;
}
entry {
    padding:                        {{ .theme.ui.padding }}px;
    background-color:               @background-alt;
    border-radius:                  {{ .theme.ui.rounding_small }}px;
    text-color:                     inherit;
    cursor:                         text;
    placeholder:                    "search...";
    placeholder-color:              inherit;
}
num-filtered-rows,
textbox-num-sep,
num-rows,
case-indicator {
    background-color:               inherit;
    text-color:                     inherit;
}

listview {
    lines:                          8;
    scrollbar:                      true;
    
    spacing:                        {{ .theme.rofi.gaps_in }}px;
    border:                         0px solid;
    background-color:               transparent;
    text-color:                     @foreground-colour;
}
scrollbar {
    handle-width:                   4px;
    handle-color:                   @foreground;
    border-radius:                  {{ .theme.ui.rounding_small }};
    background-color:               @background-alt;
}

element {
    spacing:                        {{ .theme.rofi.gaps_in }}px;
    padding:                        {{ .theme.ui.padding }}px;
    border-radius:                  {{ .theme.ui.rounding_small }}px;
    background-color:               transparent;
    text-color:                     @foreground-colour;
    cursor:                         pointer;
}
element normal.normal {
    background-color:               @normal-background;
    text-color:                     @normal-foreground;
}
element normal.urgent {
    background-color:               @urgent-background;
    text-color:                     @urgent-foreground;
}
element normal.active {
    background-color:               @active-background;
    text-color:                     @active-foreground;
}
element selected.normal {
    background-color:               @selected-normal-background;
    text-color:                     @selected-normal-foreground;
}
element selected.urgent {
    background-color:               @selected-urgent-background;
    text-color:                     @selected-urgent-foreground;
}
element selected.active {
    background-color:               @selected-active-background;
    text-color:                     @selected-active-foreground;
}
element alternate.normal {
    background-color:               @alternate-normal-background;
    text-color:                     @alternate-normal-foreground;
}
element alternate.urgent {
    background-color:               @alternate-urgent-background;
    text-color:                     @alternate-urgent-foreground;
}
element alternate.active {
    background-color:               @alternate-active-background;
    text-color:                     @alternate-active-foreground;
}
element-icon {
    background-color:               transparent;
    text-color:                     inherit;
    size:                           24px;
    cursor:                         inherit;
}
element-text {
    background-color:               transparent;
    text-color:                     inherit;
    highlight:                      inherit;
    cursor:                         inherit;
    vertical-align:                 0.5;
    horizontal-align:               0.0;
}

mode-switcher{
    spacing:                        {{ .theme.rofi.gaps_in }}px;
    margin:                         0px;
    padding:                        0px;
    border:                         0px solid;
    border-radius:                  0px;
    border-color:                   @border-colour;
    background-color:               transparent;
    text-color:                     @foreground-colour;
}
button {
    padding:                        4px 12px 4px 8px;
    border:                         0px solid;
    border-radius:                  {{ .theme.ui.rounding_small }}px;
    border-color:                   @border-colour;
    background-color:               @alternate-background;
    text-color:                     inherit;
}

button selected {
    background-color:               @active;
    text-color:                     @selected-normal-foreground;
}

message {
    border:                         0px solid;
    border-color:                   @border-colour;
    background-color:               transparent;
    text-color:                     @foreground-colour;
}
textbox {
    padding:                        {{ .theme.ui.padding }};
    border:                         0px solid;
    border-radius:                  {{ .theme.ui.rounding_small }}px;
    border-color:                   @border-colour;
    background-color:               @alternate-background;
    text-color:                     @foreground-colour;
    vertical-align:                 0.5;
    horizontal-align:               0.0;
    highlight:                      none;
    placeholder-color:              @foreground-colour;
    blink:                          true;
    markup:                         true;
}
error-message {
    padding:                        {{ .theme.ui.padding }}px;
    border:                         {{ .theme.ui.border_size }}px solid;
    border-radius:                  {{ .theme.ui.rounding_small }}px;
    border-color:                   @border-colour;
    background-color:               @background-colour;
    text-color:                     @foreground-colour;
}
