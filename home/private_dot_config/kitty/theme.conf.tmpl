# vim:ft=kitty

## name:     Catppuccin Kitty Mocha
## author:   Catppuccin Org
## license:  MIT
## upstream: https://github.com/catppuccin/kitty/blob/main/themes/mocha.conf
## blurb:    Soothing pastel theme for the high-spirited!



# The basic colors
foreground              #{{ .theme.colors.fg }}
background              #{{ .theme.colors.bg }}
selection_foreground    #{{ .theme.colors.bg }}
selection_background    #{{ .theme.colors.a_rose }}

# Cursor colors
cursor                  #{{ .theme.colors.a_rose }}
cursor_text_color       #{{ .theme.colors.bg }}

# URL underline color when hovering with mouse
url_color               #{{ .theme.colors.a_rose }}

# Kitty window border colors
active_border_color     #{{ .theme.colors.a_lavender }}
inactive_border_color   #{{ .theme.colors.o_0 }}
bell_border_color       #{{ .theme.colors.a_yellow }}

# OS Window titlebar colors
wayland_titlebar_color  #{{ .theme.colors.bg }}
macos_titlebar_color    #{{ .theme.colors.bg }}

# Tab bar colors
active_tab_foreground   #{{ .theme.colors.bg_darkest }}
active_tab_background   #{{ .theme.colors.a_mauve }}
inactive_tab_foreground #{{ .theme.colors.fg }}
inactive_tab_background #{{ .theme.colors.bg_dark }}
tab_bar_background      #{{ .theme.colors.bg_darkest }}

# Colors for marks (marked text in the terminal)
mark1_foreground #{{ .theme.colors.bg }}
mark1_background #{{ .theme.colors.a_lavender }}
mark2_foreground #{{ .theme.colors.bg }}
mark2_background #{{ .theme.colors.a_mauve }}
mark3_foreground #{{ .theme.colors.bg }}
mark3_background #{{ .theme.colors.a_sky }}

# The 16 terminal colors

# black
color0 #{{ .theme.colors.s_1 }}
color8 #{{ .theme.colors.s_2 }}

# red
color1 #{{ .theme.colors.a_red }}
color9 #{{ .theme.colors.a_red }}

# green
color2  #{{ .theme.colors.a_green }}
color10 #{{ .theme.colors.a_green }}

# yellow
color3  #{{ .theme.colors.a_yellow }}
color11 #{{ .theme.colors.a_yellow }}

# blue
color4  #{{ .theme.colors.a_blue }}
color12 #{{ .theme.colors.a_blue }}

# magenta
color5  #{{ .theme.colors.a_pink }}
color13 #{{ .theme.colors.a_pink }}

# cyan
color6  #{{ .theme.colors.a_teal }}
color14 #{{ .theme.colors.a_teal }}

# white
color7  #{{ .theme.colors.fg_dim }}
color15 #{{ .theme.colors.fg_sub }}

