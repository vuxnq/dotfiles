# https://wiki.hyprland.org/Configuring/

$lidhandle = ~/.local/bin/lidhandle.sh
$brightness = ~/.local/bin/brightness.sh
$volume = ~/.local/bin/volume.sh
$autofilen = ~/.local/bin/autofilen.sh

{{ if eq .hostname "laptop" }}
monitor = eDP-1, 1680x1050, 0x0, auto
exec = $lidhandle load
{{ else }}
monitor = HDMI-A-1, preferred, 0x0, auto
monitor = DP-3, 1920x1080@60, auto, auto
exec = ~/.local/bin/virtualmonitor.sh
{{ end }}

# keywords
$terminal = kitty
$fileManager = thunar
$wallpaper = ~/.local/share/backgrounds/waves.png

$MOD = SUPER

# rofi
$emoji = ~/.config/rofi/emoji.sh
$launcher = ~/.config/rofi/launcher.sh
$powermenu = ~/.config/rofi/powermenu.sh
$screenshot = ~/.config/rofi/screenshot.sh

# autostart
exec = killall waybar; waybar
exec = killall wlsunset; wlsunset -S 6:00 -s 19:00 -d 1800
exec = killall swaybg; swaybg -m fill -i $wallpaper
exec-once = playerctld daemon
exec-once = hypridle

# env vars
env = GTK_THEME, catppuccin-mocha-lavender-standard+default

# theme
general { 
    border_size = {{ .theme.ui.border_size }}
    gaps_in = {{ .theme.ui.gaps_in }}
    gaps_out = {{ .theme.ui.gaps_out }}

    col.active_border = rgb({{ .theme.colors.s_0 }})
    col.inactive_border = rgb({{ .theme.colors.bg }})

    snap {
        enabled = true
        respect_gaps = true
    }
}

decoration {
    rounding = {{ .theme.ui.rounding }}
    # inactive_opacity = 0.75

    blur {
        enabled = false
        size = 6
        passes = 2
    }

    shadow {
        range = 16
        render_power = 1
        color = rgba({{ .theme.colors.bg_darkest }}55)
        color_inactive = rgba({{ .theme.colors.bg_darkest }}00)
        offset = 0, 12
        scale = 0.97
    }
}

animations {
    enabled = true

    bezier = custom, 0.4, 0.5, 0, 1

    animation = windows, 1, 3, custom
    animation = border, 1, 3, custom
    animation = borderangle, 1, 8, custom
    animation = fade, 1, 2, custom
    animation = workspaces, 1, 3, custom
    animation = specialWorkspace, 1, 3, custom, slidefadevert 
}

input {
    kb_layout = us,cz
    kb_variant = ,qwerty
    kb_options = grp:caps_toggle,fkeys:basic_13-24
    numlock_by_default = true
    repeat_delay = 300
    
    accel_profile = flat

    touchpad {
        disable_while_typing = false
        natural_scroll = true
        scroll_factor = 0.25
    }
}

gesture = 4, horizontal, workspace
gesture = 3, right, dispatcher, sendshortcut, ALT, left, activewindow
gesture = 3, left, dispatcher, sendshortcut, ALT, right, activewindow

group {
    col.border_active = rgb({{ .theme.colors.s_0 }})
    col.border_inactive = rgba({{ .theme.colors.s_0 }}aa)

    groupbar {
        font_family = {{ .theme.font.name }} Bold
        height = 12
        text_color = rgb({{ .theme.colors.fg }})
        col.active = rgb({{ .theme.colors.bg_darkest }})
        col.inactive = rgba({{ .theme.colors.bg_darkest }}aa)
    }
}

misc { 
    disable_hyprland_logo = true
    force_default_wallpaper = 0
    background_color = 0x{{ .theme.colors.bg_darkest }}
    enable_swallow = true
    swallow_regex = ^($terminal)
}

binds {
    scroll_event_delay = 0
    allow_pin_fullscreen = true
}

ecosystem {
    no_donation_nag = true
}

dwindle {
    preserve_split = true
}

source = ~/.config/hypr/keybinds.conf
source = ~/.config/hypr/rules.conf
