background {
    color = rgba({{ .colors.bg_darkest }}ee)
    path = ~/.cache/screenlock.png
    blur_passes = 3
    blur_size = 6
    brightness = 0.6
}

input-field {
    size = 200, 50
    outline_thickness = 4
    outer_color = rgba({{ .colors.s_0 }}aa)
    inner_color = rgb({{ .colors.bg_darkest }})
    font_color = rgb({{ .colors.fg }})
    placeholder_text = <span font_family="{{ .font_main }} ExtraBold" foreground="##{{ .colors.fg_sub }}">Password...</span>
    check_color = rgb({{ .colors.a_lavender }})
    fail_color = rgb({{ .colors.a_red }})
    fail_text = <span font_family="{{ .font_main }} ExtraBold">$FAIL <b>($ATTEMPTS)</b></span>

    halign = center
    valign = center
}

# clock
label {
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = rgb({{ .colors.fg }})
    font_size = 30
    font_family = {{ .font_main }} ExtraBold
    
    position = 0, 85
    halign = center
    valign = center
}

label {
    text = cmd[] echo "$(date +"%a, %d %b %Y")"
    color = rgb({{ .colors.fg_sub }})
    font_size = 15
    font_family = {{ .font_main }} Bold
    
    position = 0, 50
    halign = center
    valign = center
}

# now playing
label {
    text = cmd[update:1000] ~/.local/bin/nowplaying.sh
    color = rgb({{ .colors.a_green }})
    font_size = 9
    font_family = {{ .font_main }} ExtraBold
    
    position = 0, -6
    halign = center
    valign = top
}
