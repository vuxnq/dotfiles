-- https://wiki.hypr.land/Configuring/Start/

local vars = require("vars")

-- monitors
-- https://wiki.hypr.land/Configuring/Basics/Monitors/
hl.monitor({
    output = "eDP-1",
    mode = "1680x1050",
    position = "0x0",
    scale = "auto",
})

-- autostart
-- https://wiki.hypr.land/Configuring/Basics/Autostart/
hl.on("hyprland.start", function()
    hl.exec_cmd(vars.lidhandle .. " load")

    hl.exec_cmd("killall waybar; waybar")
    hl.exec_cmd("killall wlsunset; wlsunset -S 6:00 -s 19:00 -d 1800")
    hl.exec_cmd("killall swaybg; swaybg -m fill -i " .. vars.wallpaper)
    hl.exec_cmd("playerctld daemon")
    hl.exec_cmd("hypridle")
end)

hl.on("config.reloaded", function()
    hl.exec_cmd(vars.lidhandle .. " load")
end)

-- env vars
-- https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/
hl.env("GTK_THEME", "catppuccin-mocha-lavender-standard+default")

-- theme
-- https://wiki.hypr.land/Configuring/Basics/Variables/
hl.config({
    general = {
        border_size = {{ .theme.ui.border_size }},
        gaps_in = {{ .theme.ui.gaps_in }},
        gaps_out = {{ .theme.ui.gaps_out }},

        col = {
            active_border = "rgb({{ .theme.colors.s_0 }})",
            inactive_border = "rgb({{ .theme.colors.bg }})",
        },

        snap = {
            enabled = true,
            respect_gaps = true,
        },
    },

    decoration = {
        rounding = {{ .theme.ui.rounding }},
        -- inactive_opacity = 0.75,

        blur = {
            enabled = false,
            size = 6,
            passes = 2,
        },

        shadow = {
            range = 16,
            render_power = 1,
            color = "rgba({{ .theme.colors.bg_darkest }}55)",
            color_inactive = "rgba({{ .theme.colors.bg_darkest }}00)",
            offset = { 0, 12 },
            scale = 0.97,
        },
    },

    animations = {
        enabled = true,
    },

    input = {
        kb_layout = "us,cz",
        kb_variant = ",qwerty",
        kb_options = "grp:caps_toggle,fkeys:basic_13-24",

        numlock_by_default = true,
        repeat_delay = 300,
        accel_profile = "flat",

        touchpad = {
            disable_while_typing = false,
            natural_scroll = true,
            scroll_factor = 0.25,
        },
    },

    group = {
        col = {
            border_active = "rgb({{ .theme.colors.s_0 }})",
            border_inactive = "rgba({{ .theme.colors.s_0 }}aa)",
        },

        groupbar = {
            font_family = "{{ .theme.font.name }} Bold",
            height = 12,
            text_color = "rgb({{ .theme.colors.fg }})",
            col = {
                active = "rgb({{ .theme.colors.bg_darkest }})",
                inactive = "rgba({{ .theme.colors.bg_darkest }}aa)",
            },
        },
    },

    misc = {
        disable_hyprland_logo = true,
        force_default_wallpaper = 0,
        background_color = "0x{{ .theme.colors.bg_darkest }}",
        enable_swallow = true,
        swallow_regex = "^(" .. vars.terminal .. ")$",
    },

    binds = {
        scroll_event_delay = 0,
        allow_pin_fullscreen = true,
    },

    ecosystem = {
        no_donation_nag = true,
    },

    dwindle = {
        preserve_split = true,
    },
})

-- animations
-- https://wiki.hypr.land/Configuring/Advanced-and-Cool/Animations/
hl.curve("custom", { type = "bezier", points = { { 0.4, 0.5 }, { 0, 1 } } })

hl.animation({ leaf = "windows", enabled = true, speed = 3, bezier = "custom" })
hl.animation({ leaf = "border", enabled = true, speed = 3, bezier = "custom" })
hl.animation({ leaf = "borderangle", enabled = true, speed = 8, bezier = "custom" })
hl.animation({ leaf = "fade", enabled = true, speed = 2, bezier = "custom" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 3, bezier = "custom" })
hl.animation({ leaf = "specialWorkspace", enabled = true, speed = 3, bezier = "custom", style = "slidefadevert" })

-- inputs
hl.gesture({ fingers = 4, direction = "horizontal", action = "workspace" })

hl.gesture({
    fingers = 3,
    direction = "right",
    action = function()
        hl.dispatch(hl.dsp.send_shortcut({ mods = "ALT", key = "left", window = "activewindow" }))
    end,
})

hl.gesture({
    fingers = 3,
    direction = "left",
    action = function()
        hl.dispatch(hl.dsp.send_shortcut({ mods = "ALT", key = "right", window = "activewindow" }))
    end,
})

require("keybinds")
require("rules")
