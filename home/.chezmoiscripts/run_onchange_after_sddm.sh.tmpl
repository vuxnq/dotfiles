#!/bin/bash
# hash: {{ includeTemplate "hash_dir" (joinPath .chezmoi.sourceDir "dot_extras_staging/sddm") }}
SCRIPT="sddm"

set -e

TARGET="/usr/share/sddm/themes/vuxsddm"

echo "$SCRIPT > copying the theme to sddm's themes folder"
sudo rm -rf "$TARGET"
sudo mkdir -p "$TARGET"
sudo cp -a "$HOME/.extras_staging/sddm/." "$TARGET"

echo "$SCRIPT > setting the theme"
echo -e "[Theme]\nCurrent=vuxsddm" | sudo tee /etc/sddm.conf > /dev/null

echo "$SCRIPT > done"
