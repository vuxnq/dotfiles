#!/bin/bash
SCRIPT="virtualmonitor"
{{ if eq .chezmoi.hostname "laptop" }} echo "$SCRIPT > laptop, exitting"; exit 0; {{ end }}
{{ if not .virtual_output }} echo "$SCRIPT > virtual_output not set, exitting"; exit 1; {{ end }}

EDID_FOLDER="/usr/lib/firmware/edid"
EDID_FILE="samsung-q800t-hdmi2.1"

echo "$SCRIPT > creating $EDID_FOLDER folder"
sudo mkdir -p $EDID_FOLDER

echo "$SCRIPT > downloading $EDID_FILE file into $EDID_FOLDER"
sudo wget -O $EDID_FOLDER/$EDID_FILE https://git.linuxtv.org/v4l-utils.git/plain/utils/edid-decode/data/$EDID_FILE

PARAMETERS="drm.edid_firmware={{ .virtual_output }}:edid/$EDID_FILE video={{ .virtual_output }}:e"

echo "$SCRIPT > adding kernel parameters ($PARAMETERS)"
sudo grubby --update-kernel=ALL --args="$PARAMETERS"

echo "$SCRIPT > adding edid file to dracut (/etc/dracut.conf.d/99-edid.conf)"
echo "install_items+=' $EDID_FOLDER/$EDID_FILE '" | sudo tee /etc/dracut.conf.d/99-edid.conf

echo "$SCRIPT > regenerating initramfs"
sudo dracut -f --regenerate-all

echo "$SCRIPT > done, reboot to apply the changes"
